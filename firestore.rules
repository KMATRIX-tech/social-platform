rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'keylanmbilinyi5@gmail.com' ||
        request.auth.token.email.lower() == 'keylanmbilinyi5@gnail.com'
      );
    }

    function isSubAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSubAdmin == true;
    }

    function isAdmin() {
      return isSuperAdmin() || isSubAdmin();
    }

    // Default catch-all deny rule for zero-trust baseline
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSubAdmin', 'role']))) || isSuperAdmin() || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'warningMessage', 'isBanned', 'isPro', 'hasBlueStar', 'proPlan', 'proExpiresAt', 'proBadge', 'proBorderEffect', 'proAccentColor', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // Social feed posts
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savesCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tipsCount', 'tipsTotalTZS', 'updatedAt']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBoosted', 'boostedUntil', 'boostTier', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
    }

    // Sparks: 24-hour ephemeral moments
    match /sparks/{sparkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
    }

    // Global Announcements (Admin only create/edit)
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Support Tickets & Complaints
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // User-created groups & group messages
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid in resource.data.adminIds ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && (
          (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted', 'updatedAt'])) ||
          isAdmin()
        );
        allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Real-Time Channel & Direct Messages
    match /channels/{channelId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // Global App Settings (video/voice call locks)
    match /appSettings/{settingsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Subscriptions and mobile payment transactions
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Payment Gateway Developer Settings (Client IDs, Secrets, Webhook)
    match /paymentConfig/{configId} {
      allow read, write: if isSuperAdmin();
    }

    // In-App Notifications (messages, calls, posts, follows)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // User Follows
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.followerId == request.auth.uid || isAdmin());
    }

    // Manual Mobile Money Transaction Verifications for WaveLink Pro
    match /pending_verifications/{verificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Direct Manual Payment Requests for WaveLink Pro & Harvest Pass (Private to submitting user & admins)
    match /payment_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // System Domains for OAuth Whitelisting tracking
    match /system_domains/{domainId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
